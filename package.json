{
  "name": "blockcraft",
  "private": true,
  "version": "2.0.0",
  "description": "BlockCraft · 多世界 Minecraft 服务器管理面板",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm -C server dev\" \"pnpm -C web dev\"",
    "dev:server": "pnpm -C server dev",
    "dev:web": "pnpm -C web dev",
    "build": "pnpm -C web build",
    "start": "node server/src/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "test": "pnpm -C web test",
    "test:render": "pnpm -C web test"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}